---
import '@fontsource/barlow-condensed/600.css';
import '@fontsource/barlow-condensed/700.css';
import '@fontsource-variable/inter';
import '../styles/global.css';

import Icon from '../components/Icon.astro';
import BoutonsContact from '../components/BoutonsContact.astro';
import Manquant from '../components/Manquant.astro';
import { BROUILLON, garage, servicesVisibles, ligneRue, ligneVille, lienAppel, lienItineraire, lienEmail, donneesStructurees } from '../lib/site.mjs';
import { communes } from '../data/communes.mjs';
import { listerManques } from '../data/manques.mjs';

interface Props {
  titre: string;
  description: string;
  /** Titre complet déjà formaté (sinon « titre | LM Motors … »). */
  titreComplet?: boolean;
  noindex?: boolean;
}

const { titre, description, titreComplet = false, noindex = false } = Astro.props;
const site = Astro.site?.href ?? '/';
const canonique = new URL(Astro.url.pathname, site).href;
const titrePage = titreComplet ? titre : `${titre} | ${garage.nom}, garage à Champs-sur-Yonne`;
const robots = BROUILLON || noindex ? 'noindex, nofollow' : 'index, follow';
const jsonLd = donneesStructurees(site);

const chemin = Astro.url.pathname;
const navigation = [
  { href: '/services/', nom: 'Prestations' },
  { href: '/zone-intervention/', nom: 'Zone d’intervention' },
  { href: '/acces/', nom: 'Accès & horaires' },
  { href: '/avis/', nom: 'Avis' },
  { href: '/devis/', nom: 'Devis & RDV', mobileSeul: true },
];

const manques = BROUILLON ? listerManques() : [];
const nbBloquants = manques.filter((m) => m.niveau === 'bloquant').length;
const nbImportants = manques.filter((m) => m.niveau === 'important').length;
const plausible = garage.analytics.plausibleDomain;
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titrePage}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonique} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#101318" />
    <meta name="format-detection" content="telephone=no" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content={garage.nom} />
    <meta property="og:title" content={titrePage} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonique} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    {plausible && <script defer data-domain={plausible} src="https://plausible.io/js/script.js"></script>}
    <slot name="head" />
  </head>
  <body>
    <a class="lien-evitement" href="#contenu">Aller au contenu</a>

    {BROUILLON && (
      <div class="bandeau-brouillon" role="note">
        <div class="conteneur">
          <span>Version de travail, non publiée : {nbBloquants} information{nbBloquants > 1 ? 's' : ''} bloquante{nbBloquants > 1 ? 's' : ''} et {nbImportants} importante{nbImportants > 1 ? 's' : ''} à compléter.</span>
          <a href="/brouillon/">Voir la liste →</a>
        </div>
      </div>
    )}

    <header class="entete">
      <div class="conteneur entete__barre">
        <a href="/" class="logo" aria-label={`${garage.nom}, accueil`}>
          <span class="logo__monogramme" aria-hidden="true"><span>LM</span></span>
          <span class="logo__texte">
            <span class="logo__nom">{garage.nom}</span>
            <span class="logo__lieu">Garage · Champs-sur-Yonne</span>
          </span>
        </a>

        <nav class="nav" aria-label="Navigation principale">
          <div class="nav__menu" id="menu-principal" data-ouvert="false">
            <ul class="nav__liste">
              {navigation.map((l) => (
                <li class:list={[l.mobileSeul && 'nav__item--mobile']}>
                  <a class="nav__lien" href={l.href} aria-current={chemin.startsWith(l.href) ? 'page' : undefined}>
                    {l.nom}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </nav>

        <div class="entete__actions">
          <BoutonsContact variante="entete" whatsapp={false} />
          <button class="nav__bouton" type="button" aria-expanded="false" aria-controls="menu-principal" data-bouton-menu>
            <span class="visuellement-cache" data-libelle-menu>Ouvrir le menu</span>
            <Icon name="menu" />
          </button>
        </div>
      </div>
    </header>

    <main id="contenu">
      <slot />
    </main>

    <footer class="pied">
      <div class="conteneur">
        <div class="pied__grille">
          <div>
            <a href="/" class="logo" aria-label={`${garage.nom}, accueil`}>
              <span class="logo__monogramme" aria-hidden="true"><span>LM</span></span>
              <span class="logo__texte">
                <span class="logo__nom">{garage.nom}</span>
                <span class="logo__lieu">Garage · Champs-sur-Yonne</span>
              </span>
            </a>
            <address style="font-style: normal; margin-top: 20px;">
              {ligneRue}{!garage.adresse.numero && BROUILLON && <> <Manquant quoi="n°" /></>}<br />
              {garage.adresse.complement && <>{garage.adresse.complement}<br /></>}
              {ligneVille}
              {lienAppel && <><br /><a href={lienAppel} data-suivi="Appel">{garage.telephone}</a></>}
              {garage.email && <><br /><a href={lienEmail(garage.email)}>{garage.email}</a></>}
            </address>
            <p style="margin-top: 14px;"><a href={lienItineraire} target="_blank" rel="noopener" data-suivi="Itinéraire">Itinéraire →</a></p>
          </div>

          <div>
            <h2>Prestations</h2>
            <ul>
              {servicesVisibles.slice(0, 7).map((s) => <li><a href={`/services/${s.slug}/`}>{s.titre}</a></li>)}
              <li><a href="/services/">Toutes les prestations</a></li>
            </ul>
          </div>

          <div>
            <h2>Zone d’intervention</h2>
            <ul>
              {communes.slice(0, 7).map((c) => <li><a href={`/${c.slug}/`}>Garage près de {c.nom}</a></li>)}
              <li><a href="/zone-intervention/">Toutes les communes</a></li>
            </ul>
          </div>

          <div>
            <h2>Infos pratiques</h2>
            <ul>
              <li><a href="/devis/">Demande de devis ou de RDV</a></li>
              <li><a href="/acces/">Accès & horaires</a></li>
              <li><a href="/avis/">Laisser un avis</a></li>
              <li><a href="/mentions-legales/">Mentions légales</a></li>
              <li><a href="/confidentialite/">Confidentialité</a></li>
              {BROUILLON && <li><a href="/brouillon/">Liste des infos à compléter</a></li>}
            </ul>
          </div>
        </div>

        <div class="pied__bas">
          <span>© {new Date().getFullYear()} {garage.nom} · Garage automobile à Champs-sur-Yonne (89290), Yonne</span>
          <span>{garage.liens.facebook && <a href={garage.liens.facebook} rel="noopener" target="_blank">Facebook</a>} {garage.liens.instagram && <a href={garage.liens.instagram} rel="noopener" target="_blank">Instagram</a>}</span>
        </div>
      </div>
    </footer>

    <nav class="barre-mobile" aria-label="Contacter le garage">
      <BoutonsContact variante="barre" />
    </nav>

    <script>
      import { initialiserSuivi } from '../scripts/suivi.js';
      initialiserSuivi();

      const bouton = document.querySelector<HTMLButtonElement>('[data-bouton-menu]');
      const menu = document.getElementById('menu-principal');
      const libelle = document.querySelector('[data-libelle-menu]');
      bouton?.addEventListener('click', () => {
        const ouvert = bouton.getAttribute('aria-expanded') === 'true';
        bouton.setAttribute('aria-expanded', String(!ouvert));
        menu?.setAttribute('data-ouvert', String(!ouvert));
        if (libelle) libelle.textContent = ouvert ? 'Ouvrir le menu' : 'Fermer le menu';
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && bouton?.getAttribute('aria-expanded') === 'true') {
          bouton.click();
          bouton.focus();
        }
      });
    </script>
  </body>
</html>
