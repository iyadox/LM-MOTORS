---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import BoutonsContact from '../components/BoutonsContact.astro';
import Horaires from '../components/Horaires.astro';
import Manquant from '../components/Manquant.astro';
import AConfirmer from '../components/AConfirmer.astro';
import CarteService from '../components/CarteService.astro';
import ListeAvis from '../components/ListeAvis.astro';
import Faq from '../components/Faq.astro';
import BandeCTA from '../components/BandeCTA.astro';
import {
  BROUILLON,
  garage,
  acces,
  avis,
  servicesVisibles,
  communesVisibles,
  listePrestations,
  ligneRue,
  rueTexte,
  ligneVille,
  lienAppel,
  lienItineraire,
} from '../lib/site.mjs';
import { engagements } from '../data/garage.mjs';
import { communeGarage } from '../data/communes.mjs';
import { faqGenerale } from '../data/faq.mjs';

const engagementsVisibles = engagements.filter((e) => e.valide || BROUILLON);
const prestations = listePrestations(3);
const fmt = new Intl.NumberFormat('fr-FR');
const habitants = fmt.format(Math.round(communeGarage.population / 100) * 100);
---
<Base
  titre={`Garage automobile à Champs-sur-Yonne, près d’Auxerre | ${garage.nom}`}
  titreComplet
  description={`${garage.nom}, garage automobile à Champs-sur-Yonne (89290), au sud d’Auxerre${prestations ? ` : ${prestations}` : ''}. Devis ou rendez-vous en ligne.`}
>
  <!-- Héros : l'essentiel pour contacter le garage, visible immédiatement -->
  <section class="hero">
    <div class="conteneur hero__interieur">
      <div>
        <p class="surtitre">{garage.nom} · Yonne (89)</p>
        <h1>
          Garage automobile{' '}
          <span class="accent">à Champs-sur-Yonne</span>
        </h1>
        <p class="hero__accroche">
          Entretien et réparation de votre voiture, {acces.situation}.
          Décrivez votre besoin en ligne : votre demande est transmise au garage.
        </p>
        <div class="groupe-boutons">
          <BoutonsContact variante="hero" />
        </div>
        <p class="hero__adresse">
          <Icon name="map-pin" size={18} />
          {ligneRue}, {ligneVille}
        </p>
      </div>

      <aside class="carte-contact" aria-labelledby="titre-contact">
        <h2 class="carte-contact__titre" id="titre-contact">Contact rapide</h2>
        <div class="carte-contact__ligne">
          <Icon name="map-pin" size={22} />
          <div>
            <strong>{ligneRue}{!garage.adresse.numero && BROUILLON && <>{' '}<Manquant quoi="n°" /></>}</strong>
            {ligneVille}
            <br /><a class="lien-cible" href={lienItineraire} target="_blank" rel="noopener" data-suivi="Itinéraire" data-suivi-lieu="carte">Itinéraire</a>
          </div>
        </div>
        <div class="carte-contact__ligne">
          <Icon name="clock" size={22} />
          <div>
            <strong>Horaires</strong>
            {garage.horaires ? <Horaires statutSeul clair={false} /> : <Manquant quoi="horaires"><span>Sur demande</span></Manquant>}
            <br /><a class="lien-cible" href="/acces/">Voir les horaires</a>
          </div>
        </div>
        <div class="carte-contact__ligne carte-contact__ligne--derniere">
          <Icon name="phone" size={22} />
          <div>
            <strong>Téléphone</strong>
            {lienAppel ? <a class="lien-cible lien-cible--blanc" href={lienAppel} data-suivi="Appel" data-suivi-lieu="carte">{garage.telephone}</a> : <Manquant quoi="numéro"><span>Par le formulaire de demande</span></Manquant>}
          </div>
        </div>
        <div class="groupe-boutons">
          <BoutonsContact variante="carte" />
        </div>
      </aside>
    </div>
  </section>

  <!-- Arguments : uniquement ceux validés par le gérant -->
  {engagementsVisibles.length > 0 && (
    <section class="section section--serree section--gris" aria-labelledby="titre-engagements">
      <div class="conteneur">
        <h2 class="visuellement-cache" id="titre-engagements">Nos engagements</h2>
        <div class="grille grille--4">
          {engagementsVisibles.map((e) => (
            <AConfirmer valide={e.valide} class="carte">
              <span class="carte__icone"><Icon name="shield-check" size={26} /></span>
              <h3>{e.titre}</h3>
              <p>{e.texte}</p>
            </AConfirmer>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Prestations -->
  {servicesVisibles.length > 0 && (
    <section class="section" aria-labelledby="titre-prestations">
      <div class="conteneur">
        <div class="entete-section">
          <p class="surtitre">Prestations</p>
          <h2 id="titre-prestations">Entretien et réparation de votre véhicule</h2>
          <p>Choisissez une prestation pour savoir en quoi elle consiste, quand s’en occuper et comment demander un devis.</p>
        </div>
        <div class="grille grille--3">
          {servicesVisibles.map((s) => <CarteService service={s} />)}
        </div>
      </div>
    </section>
  )}

  <!-- Vrais avis clients, s'il y en a -->
  {avis.length > 0 && (
    <section class="section section--gris" aria-labelledby="titre-avis">
      <div class="conteneur">
        <div class="entete-section">
          <p class="surtitre">Avis</p>
          <h2 id="titre-avis">Avis publiés sur Google</h2>
        </div>
        <ListeAvis max={3} />
        {garage.liens.googleFiche && (
          <p style="margin-top: 24px;"><a href={garage.liens.googleFiche} target="_blank" rel="noopener">Voir tous les avis sur Google →</a></p>
        )}
      </div>
    </section>
  )}

  <!-- Déroulé -->
  <section class="section section--sombre" aria-labelledby="titre-etapes">
    <div class="conteneur">
      <div class="entete-section">
        <p class="surtitre">Comment ça se passe</p>
        <h2 id="titre-etapes">Votre demande en 3 étapes</h2>
      </div>
      <ol class="etapes grille grille--3">
        <li class="etape">
          <h3>Vous décrivez le besoin</h3>
          <p>Par le formulaire en ligne{lienAppel ? ', par téléphone' : ''}{garage.whatsapp ? ' ou par WhatsApp' : ''} : votre véhicule, le problème, une photo si besoin.</p>
        </li>
        <li class="etape">
          <h3>Le garage reçoit la demande</h3>
          <p>Votre demande est transmise à {garage.nom}, qui revient vers vous pour le devis et le créneau.</p>
        </li>
        <li class="etape">
          <h3>Vous déposez la voiture</h3>
          <p>{ligneRue}, à Champs-sur-Yonne, {acces.situation}.</p>
        </li>
      </ol>
      <div class="groupe-boutons" style="margin-top: 32px;">
        <a href="/devis/" class="btn btn--accent" data-suivi="Clic devis" data-suivi-lieu="etapes"><Icon name="calendar-check" size={20} /> Faire ma demande</a>
      </div>
    </div>
  </section>

  <!-- Le garage -->
  <section class="section" aria-labelledby="titre-garage">
    <div class="conteneur grille grille--2" style="align-items: center;">
      <div>
        <p class="surtitre">Le garage</p>
        <h2 id="titre-garage">À Champs-sur-Yonne, dans l’Auxerrois</h2>
        <p>
          {garage.nom} est installé {rueTexte}, à Champs-sur-Yonne ({communeGarage.codePostal}), une commune d’environ
          {' '}{habitants} habitants de la Communauté d’agglomération de l’Auxerrois, {acces.situation}.
        </p>
        <ul class="liste-coches">
          <li><Icon name="map-pin" size={20} /> <span>{ligneRue}, {ligneVille}</span></li>
          <li><Icon name="train-front" size={20} /> <span>Gare « {acces.gare} » sur la commune</span></li>
          {acces.tempsDepuisAuxerre && <li><Icon name="navigation" size={20} /> <span>{acces.tempsDepuisAuxerre} depuis Auxerre</span></li>}
        </ul>
        <div class="groupe-boutons" style="margin-top: 24px;">
          <a href="/acces/" class="btn btn--contour">Accès & horaires</a>
        </div>
      </div>
      {garage.visuels.photos[0] ? (
        <img class="photo-garage" src={garage.visuels.photos[0].src} alt={garage.visuels.photos[0].alt} loading="lazy" />
      ) : BROUILLON && (
        <div class="photo-a-fournir">
          <Icon name="car" size={40} />
          Photo réelle de l’atelier à fournir par le gérant<br />(façade, atelier, équipe)
        </div>
      )}
    </div>
  </section>

  <!-- Communes proches -->
  {communesVisibles.length > 0 && (
    <section class="section section--sombre" aria-labelledby="titre-zone">
      <div class="conteneur">
        <div class="entete-section">
          <p class="surtitre">Communes proches</p>
          <h2 id="titre-zone">Auxerre et ses environs</h2>
          <p>Vous habitez une commune voisine ? Retrouvez les informations utiles pour venir au garage depuis chez vous.</p>
        </div>
        <ul class="liste-communes">
          {communesVisibles.map((c) => (
            <li><a href={`/${c.slug}/`}><Icon name="map-pin" size={16} /> {c.nom}</a></li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- FAQ -->
  <section class="section section--gris" aria-labelledby="titre-faq">
    <div class="conteneur" style="max-width: 900px;">
      <div class="entete-section">
        <p class="surtitre">Questions fréquentes</p>
        <h2 id="titre-faq">Bon à savoir</h2>
      </div>
      <Faq questions={faqGenerale} />
    </div>
  </section>

  <BandeCTA />
</Base>
