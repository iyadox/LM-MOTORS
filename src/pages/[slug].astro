---
/** Pages locales « Garage près de <commune> » (données vérifiées : src/data/communes.mjs). */
import Base from '../layouts/Base.astro';
import Ariane from '../components/Ariane.astro';
import Icon from '../components/Icon.astro';
import Manquant from '../components/Manquant.astro';
import BoutonsContact from '../components/BoutonsContact.astro';
import BandeCTA from '../components/BandeCTA.astro';
import { BROUILLON, garage, acces, servicesVisibles, ligneRue, ligneVille } from '../lib/site.mjs';
import { communes } from '../data/communes.mjs';

export function getStaticPaths() {
  return communes.map((commune) => ({ params: { slug: commune.slug }, props: { commune } }));
}

const { commune: c } = Astro.props;
const fmt = new Intl.NumberFormat('fr-FR');
const cp = c.codesPostaux.join(', ');
const itineraire = `https://www.google.com/maps/dir/?api=1&origin=${encodeURIComponent(`${c.nom} ${c.codesPostaux[0]}`)}&destination=${encodeURIComponent(`${ligneRue}, ${ligneVille}`)}`;
const autres = communes.filter((x) => x.slug !== c.slug);
---
<Base
  titre={`Garage auto près de ${c.nom} (${c.codesPostaux[0]})`}
  description={`Garage automobile près de ${c.nom} : ${garage.nom}, rue Robert Raclot à Champs-sur-Yonne, au sud d’Auxerre. Entretien, réparation, diagnostic. Devis et rendez-vous en ligne.`}
>
  <section class="entete-page">
    <div class="conteneur">
      <Ariane elements={[{ nom: 'Zone d’intervention', href: '/zone-intervention/' }, { nom: c.nom }]} />
      <h1>Garage auto près de {c.nom}</h1>
      <p>Vous habitez {c.nom} ({cp}) ? {garage.nom} est un garage automobile installé rue Robert Raclot, à Champs-sur-Yonne, {acces.situation}.</p>
    </div>
  </section>

  <section class="section">
    <div class="conteneur deux-colonnes">
      <div class="prose">
        <h2>Venir au garage depuis {c.nom}</h2>
        {c.trajet ? <p>{c.trajet}.</p> : BROUILLON && <p><Manquant quoi={`temps de trajet mesuré depuis ${c.nom}`} /></p>}
        <p>Adresse du garage : <strong>{ligneRue}, {ligneVille}</strong>.</p>
        <a href={itineraire} class="btn btn--sombre" target="_blank" rel="noopener" data-suivi="Itinéraire">
          <Icon name="navigation" size={20} /> Itinéraire depuis {c.nom}
        </a>

        <h2>{c.nom} en bref</h2>
        <div class="chiffres">
          <div class="chiffre"><strong>{fmt.format(c.population)}</strong><span>habitants (population municipale, INSEE)</span></div>
          <div class="chiffre"><strong>{cp}</strong><span>code postal</span></div>
        </div>
        <ul class="liste-coches" style="margin-top: 20px;">
          <li><Icon name="check" size={20} /> <span>{c.nom} fait partie de la {c.epci}.</span></li>
          {c.faits.map((f) => <li><Icon name="check" size={20} /> <span>{f}</span></li>)}
        </ul>

        {servicesVisibles.length > 0 && (
          <>
            <h2>Prestations</h2>
            <ul class="liste-communes liste-communes--clair">
              {servicesVisibles.map((s) => <li><a href={`/services/${s.slug}/`}>{s.titre}</a></li>)}
            </ul>
          </>
        )}
      </div>

      <aside class="aside-carte" aria-labelledby="titre-aside">
        <h2 id="titre-aside">Devis ou rendez-vous</h2>
        <p>Décrivez votre besoin en ligne : la demande arrive directement au garage.</p>
        <div class="groupe-boutons">
          <BoutonsContact variante="carte" />
        </div>
      </aside>
    </div>
  </section>

  <section class="section section--gris section--serree">
    <div class="conteneur">
      <h2>Autres communes de la zone</h2>
      <ul class="liste-communes liste-communes--clair" style="margin-top: 16px;">
        {autres.map((a) => <li><a href={`/${a.slug}/`}>{a.nom}</a></li>)}
      </ul>
    </div>
  </section>

  <BandeCTA titre={`Votre voiture, de ${c.nom} à Champs-sur-Yonne`} />
</Base>
