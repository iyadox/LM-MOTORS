---
/** Tableau de bord de la version de travail : tout ce qui manque avant la mise en ligne. */
import Base from '../layouts/Base.astro';
import { listerManques, ORDRE_NIVEAUX } from '../data/manques.mjs';
import { BROUILLON } from '../lib/site.mjs';

const manques = listerManques().sort((a, b) => ORDRE_NIVEAUX[a.niveau] - ORDRE_NIVEAUX[b.niveau]);
const compte = (n) => manques.filter((m) => m.niveau === n).length;
---
<Base titre="Informations à compléter" description="Liste des informations à fournir avant la mise en ligne du site." noindex>
  <section class="entete-page">
    <div class="conteneur">
      <p class="surtitre">Version de travail</p>
      <h1>Avant la mise en ligne</h1>
      <p>
        Le site n’affiche que des informations vérifiées. Tout ce qui est encore inconnu est listé ici :
        à compléter dans <code>src/data/garage.mjs</code> (et <code>services.mjs</code>, <code>communes.mjs</code>) avec le gérant.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="conteneur">
      {!BROUILLON && <p>Ce site est en mode production.</p>}
      <div class="chiffres" style="margin-bottom: 32px;">
        <div class="chiffre"><strong>{compte('bloquant')}</strong><span>bloquant(s) : empêchent la mise en ligne</span></div>
        <div class="chiffre"><strong>{compte('important')}</strong><span>important(s) : efficacité et crédibilité</span></div>
        <div class="chiffre"><strong>{compte('utile')}</strong><span>utile(s) : à faire dès que possible</span></div>
      </div>
      <div style="overflow-x: auto;">
        <table class="tableau-brouillon">
          <thead>
            <tr><th scope="col">Niveau</th><th scope="col">Rubrique</th><th scope="col">Information</th><th scope="col">Où la renseigner</th></tr>
          </thead>
          <tbody>
            {manques.map((m) => (
              <tr>
                <td><span class={`niveau niveau--${m.niveau}`}>{m.niveau}</span></td>
                <td>{m.rubrique}</td>
                <td>{m.libelle}</td>
                <td><code>{m.aide}</code></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p style="margin-top: 32px; color: var(--texte-doux);">
        Le questionnaire à faire remplir par le gérant se trouve dans <code>recherche/questions-gerant.md</code>.
        Une fois tout complété : <code>npm run build:production</code>.
      </p>
    </div>
  </section>
</Base>
