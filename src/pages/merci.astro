---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import BoutonsContact from '../components/BoutonsContact.astro';
import { BROUILLON, garage, lienAppel, lienTel, whatsappE164 } from '../lib/site.mjs';

const rappel = garage.formulaire.numeroRappel;
---
<Base titre="Demande envoyée" description={`Votre demande a bien été transmise au garage ${garage.nom}.`} noindex>
  <section class="entete-page">
    <div class="conteneur">
      <p class="surtitre"><Icon name="check" size={18} /> Demande envoyée</p>
      <h1>{BROUILLON ? 'Demande de test enregistrée' : 'Merci, c’est envoyé !'}</h1>
      <p>
        {BROUILLON
          ? 'Version de travail : cette demande sert à vérifier la réception. Elle n’est pas encore traitée par le garage.'
          : `Votre demande a été transmise à ${garage.nom}, avec votre préférence pour être recontacté.`}
      </p>
    </div>
  </section>
  <section class="section">
    <div class="conteneur" style="max-width: 760px;">
      <div class="recapitulatif" data-recapitulatif hidden>
        <h2>Récapitulatif</h2>
        <dl>
          <dt>Prestation</dt><dd data-recap="prestation"></dd>
          <dt>Véhicule</dt><dd data-recap="vehicule"></dd>
          <dt>Recontact</dt><dd data-recap="recontact"></dd>
          <dt>Votre numéro</dt><dd data-recap="telephone"></dd>
        </dl>
        <p class="message-formulaire" data-type="erreur" data-recap-photo hidden>
          Votre photo n’a pas pu être envoyée.{' '}
          {whatsappE164 || garage.email ? 'Vous pouvez l’envoyer par WhatsApp ou par e-mail.' : 'Le garage pourra vous la demander.'}
        </p>
        <p class="champ__aide">Une erreur dans votre numéro ? <a href="/devis/">Refaites la demande</a>{lienAppel && <> ou appelez le <a href={lienAppel} data-suivi="Appel" data-suivi-lieu="merci">{garage.telephone}</a></>}.</p>
      </div>

      {rappel && (
        <p class="encadre">
          <strong>Pour reconnaître l’appel du garage</strong>
          Le garage vous rappelle depuis le <a href={lienTel(rappel)}>{rappel}</a>. <a href="/lm-motors.vcf" download>Enregistrer ce numéro dans mes contacts</a>.
        </p>
      )}

      <h2>En attendant</h2>
      <ul class="liste-coches">
        <li><Icon name="check" size={20} /> <span>Gardez votre carnet d’entretien et vos dernières factures à portée de main.</span></li>
        <li><Icon name="check" size={20} /> <span>Un voyant s’est allumé ? Une photo du tableau de bord aidera le garage.</span></li>
        <li><Icon name="check" size={20} /> <span>Un voyant rouge signale un danger : évitez de rouler avant le contrôle.</span></li>
      </ul>
      <div class="groupe-boutons" style="margin-top: 32px;">
        <BoutonsContact variante="hero" devis={false} />
        <a href="/" class="btn btn--contour">Retour à l’accueil</a>
      </div>
    </div>
  </section>
</Base>

<script>
  // Récapitulatif de la demande (gardé le temps de l'affichage, puis effacé : il contient un numéro).
  try {
    const demande = JSON.parse(sessionStorage.getItem('lm-demande') || 'null');
    sessionStorage.removeItem('lm-demande');
    const bloc = document.querySelector<HTMLElement>('[data-recapitulatif]');
    if (demande && bloc) {
      for (const [cle, valeur] of Object.entries(demande)) {
        const dd = bloc.querySelector(`[data-recap="${cle}"]`);
        if (dd) dd.textContent = String(valeur || '—');
      }
      if (demande.photo === 'non transmise') bloc.querySelector<HTMLElement>('[data-recap-photo]')?.removeAttribute('hidden');
      bloc.hidden = false;
    }
  } catch {
    /* pas de récapitulatif : le texte général suffit */
  }
</script>
