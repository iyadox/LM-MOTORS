---
import Base from '../../layouts/Base.astro';
import Ariane from '../../components/Ariane.astro';
import Icon from '../../components/Icon.astro';
import Manquant from '../../components/Manquant.astro';
import ListeAvis from '../../components/ListeAvis.astro';
import BandeCTA from '../../components/BandeCTA.astro';
import { BROUILLON, garage, avis, pageAvisVisible } from '../../lib/site.mjs';

// En production, pas de page « Avis » sans lien pour en laisser ni avis à montrer.
if (!pageAvisVisible) return Astro.redirect('/');

const lienDepot = garage.liens.googleAvis || garage.liens.googleFiche;
const AP = garage.avisPolitique;
---
<Base
  titre="Avis clients"
  description={`Vous êtes passé chez ${garage.nom}, garage à Champs-sur-Yonne ? Partagez votre expérience : votre avis aide les automobilistes de l’Auxerrois à choisir leur garage.`}
>
  <section class="entete-page">
    <div class="conteneur">
      <Ariane elements={[{ nom: 'Avis' }]} />
      <h1>Votre avis compte</h1>
      <p>Vous êtes passé chez {garage.nom} ? Quelques mots suffisent : votre avis aide les automobilistes de l’Auxerrois à choisir leur garage.</p>
    </div>
  </section>

  <section class="section">
    <div class="conteneur">
      <div class="grille grille--2" style="align-items: start;">
        {(lienDepot || BROUILLON) && (
          <div>
            <h2>Laisser un avis</h2>
            {lienDepot ? (
              <a href={lienDepot} class="btn btn--accent" target="_blank" rel="noopener" data-suivi="Avis Google" data-suivi-lieu="avis">
                <Icon name="star" size={20} /> {garage.liens.googleAvis ? 'Laisser un avis sur Google' : 'Donner votre avis sur la fiche Google'}
              </a>
            ) : (
              <p><Manquant quoi="lien « Demander des avis » de la fiche Google Business Profile" /></p>
            )}
            <ul class="liste-coches" style="margin-top: 28px;">
              <li><Icon name="check" size={20} /> <span>Racontez ce qui a été fait et comment ça s’est passé.</span></li>
              <li><Icon name="check" size={20} /> <span>Un avis honnête, positif ou non, est toujours utile.</span></li>
            </ul>
            {garage.liens.googleFiche && (
              <p style="margin-top: 20px;"><a href={garage.liens.googleFiche} target="_blank" rel="noopener">Voir les avis sur Google →</a></p>
            )}
          </div>
        )}

        {(avis.length > 0 || BROUILLON) && (
          <div>
            <h2>Avis publiés sur Google</h2>
            {avis.length > 0 ? (
              <ListeAvis />
            ) : (
              <p class="note-bas">
                Aucun avis pour l’instant : seuls de vrais avis, recopiés mot pour mot depuis la fiche Google (les plus récents,
                quelle que soit la note), seront affichés ici (fichier src/data/avis.mjs). Cette colonne est masquée en production tant qu’il n’y en a pas.
              </p>
            )}
          </div>
        )}
      </div>

      {(avis.length > 0 || BROUILLON) && (
        <div class="prose" id="publication-avis" style="margin-top: 48px;">
          <h2>Comment les avis sont publiés</h2>
          <ul>
            <li>Les avis affichés sur ce site sont recopiés sans modification depuis la fiche Google du garage, du plus récent au plus ancien, quelle que soit la note. Ils ne sont pas vérifiés par le garage.</li>
            <li>Contrepartie : {AP.contrepartie ?? <Manquant quoi="contrepartie ou non en échange d’un avis" />}</li>
            <li>Délai de publication : {AP.delaiPublication ?? <Manquant quoi="délai maximum de publication" />}</li>
            <li>Durée de conservation : {AP.dureeConservation ?? <Manquant quoi="durée d’affichage d’un avis" />}</li>
          </ul>
        </div>
      )}
    </div>
  </section>

  <BandeCTA />
</Base>
