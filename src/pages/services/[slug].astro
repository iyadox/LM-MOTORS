---
import Base from '../../layouts/Base.astro';
import Ariane from '../../components/Ariane.astro';
import Icon from '../../components/Icon.astro';
import BoutonsContact from '../../components/BoutonsContact.astro';
import BandeCTA from '../../components/BandeCTA.astro';
import { servicesVisibles, BROUILLON, garage, acces, ligneRue, ligneVille, lienItineraire } from '../../lib/site.mjs';

export function getStaticPaths() {
  return servicesVisibles.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

const { service: s } = Astro.props;
const autres = servicesVisibles.filter((x) => x.slug !== s.slug).slice(0, 4);
const devisHref = `/devis/?prestation=${s.slug}`;
const titreCourt = s.titreCourt ?? s.titre;
// Titre ≤ 65 caractères : sans le suffixe de marque s'il le faut (la marque reste dans la description).
const titreBase = `${titreCourt} à Champs-sur-Yonne, près d’Auxerre`;
const titreAvecMarque = `${titreBase} | ${garage.nom}`;
---
<Base
  titre={titreAvecMarque.length > 65 ? titreBase : titreAvecMarque}
  titreComplet
  description={`${s.resume} ${garage.nom}, garage à Champs-sur-Yonne (89290), près d’Auxerre. Devis en ligne.`}
  devisHref={devisHref}
  prestation={s.titre}
>
  <section class="entete-page">
    <div class="conteneur">
      <Ariane elements={[{ nom: 'Prestations', href: '/services/' }, { nom: s.titre }]} />
      <h1>{s.titre}</h1>
      <p>{s.intro}</p>
      {!s.valide && BROUILLON && <p><span class="manquant">Prestation à confirmer par le gérant (ligne par ligne)</span></p>}
      {s.prix && s.valide && <p class="prix-entete">{s.prix}</p>}
      <div class="groupe-boutons entete-page__actions">
        <a href={devisHref} class="btn btn--accent" data-suivi="Clic devis" data-suivi-lieu="entete-prestation">
          <Icon name="calendar-check" size={20} /> Devis {s.titre.toLowerCase()}
        </a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="conteneur deux-colonnes">
      <div class="prose">
        <h2>En quoi consiste l’intervention</h2>
        <ul class="liste-coches">
          {s.contenu.map((c) => <li><Icon name="check" size={20} /> <span>{c}</span></li>)}
        </ul>

        <h2>Quand faut-il s’en occuper ?</h2>
        <ul class="liste-coches">
          {s.signes.map((c) => <li><Icon name="arrow-right" size={20} /> <span>{c}</span></li>)}
        </ul>

        <div class="encadre" style="margin-top: 32px;">
          <strong>Bon à savoir</strong>
          {s.bonASavoir}
        </div>
      </div>

      <aside class="aside-carte" aria-labelledby="titre-aside">
        <h2 id="titre-aside">Demander un devis</h2>
        {s.prix && s.valide && <p class="carte__prix">{s.prix}</p>}
        {s.prix && s.valide && s.prixInclus?.length > 0 && <p class="champ__aide">Comprend : {s.prixInclus.join(', ')}.</p>}
        <p>Indiquez votre véhicule et votre besoin : la demande est transmise au garage.</p>
        <p class="aside-adresse">
          <Icon name="map-pin" size={18} />
          <span>{garage.nom}, {ligneRue}, {ligneVille} ({acces.situation}) · <a href="/acces/">Accès</a> · <a href={lienItineraire} target="_blank" rel="noopener" data-suivi="Itinéraire" data-suivi-lieu="aside-prestation">Itinéraire</a></span>
        </p>
        <div class="groupe-boutons">
          <a href={devisHref} class="btn btn--accent btn--large" data-suivi="Clic devis" data-suivi-lieu="aside-prestation">
            <Icon name="calendar-check" size={20} /> Devis {s.titre.toLowerCase()}
          </a>
          <BoutonsContact variante="carte" devis={false} prestation={s.titre} />
        </div>
      </aside>
    </div>
  </section>

  {autres.length > 0 && (
    <section class="section section--gris section--serree">
      <div class="conteneur">
        <h2>Autres prestations</h2>
        <ul class="liste-communes liste-communes--clair" style="margin-top: 16px;">
          {autres.map((a) => <li><a href={`/services/${a.slug}/`}>{a.titre}</a></li>)}
          <li><a href="/services/">Toutes les prestations</a></li>
        </ul>
      </div>
    </section>
  )}

  <BandeCTA />
</Base>
