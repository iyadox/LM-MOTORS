---
import Base from '../../layouts/Base.astro';
import Ariane from '../../components/Ariane.astro';
import CarteService from '../../components/CarteService.astro';
import BandeCTA from '../../components/BandeCTA.astro';
import { garage, servicesVisibles, listePrestations } from '../../lib/site.mjs';

const liste = listePrestations(4);
const titre = 'Prestations du garage à Champs-sur-Yonne';
---
<Base
  titre={titre}
  description={`Prestations de ${garage.nom}, garage à Champs-sur-Yonne (89290), au sud d’Auxerre${liste ? ` : ${liste}` : ''}. Demande de devis en ligne.`}
>
  <section class="entete-page">
    <div class="conteneur">
      <Ariane elements={[{ nom: 'Prestations' }]} />
      <h1>Nos prestations</h1>
      <p>Les prestations de {garage.nom} à Champs-sur-Yonne (89290), au sud d’Auxerre : en quoi elles consistent, les signes qui doivent vous alerter, et la demande de devis.</p>
    </div>
  </section>

  <section class="section">
    <div class="conteneur">
      {servicesVisibles.length > 0 ? (
        <div class="grille grille--3">
          {servicesVisibles.map((s) => <CarteService service={s} niveauTitre="h2" />)}
        </div>
      ) : (
        <p>La liste des prestations sera bientôt en ligne.</p>
      )}
      <p class="note-bas">
        Votre besoin n’est pas dans la liste ? Décrivez-le dans la <a href="/devis/">demande de devis</a>.
      </p>
    </div>
  </section>

  <BandeCTA />
</Base>
