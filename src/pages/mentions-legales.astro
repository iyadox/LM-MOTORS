---
import Base from '../layouts/Base.astro';
import Ariane from '../components/Ariane.astro';
import Manquant from '../components/Manquant.astro';
import { BROUILLON, garage, ligneRue, ligneVille, lienEmail } from '../lib/site.mjs';

const L = garage.legal;
const H = garage.hebergeur;
const M = L.mediateur;
const ei = L.statut === 'ei';
// En production, chaque ligne n'apparaît que si la donnée existe (les données obligatoires
// sont exigées par `npm run build:production`) ; en brouillon, les manques sont signalés.
const ligne = (valeur: unknown) => Boolean(valeur) || BROUILLON;
const editeur = L.raisonSociale ? (ei ? `${L.raisonSociale} EI` : L.raisonSociale) : null;
---
<Base titre="Mentions légales" description={`Mentions légales du site de ${garage.nom}, garage automobile à Champs-sur-Yonne (89290).`}>
  <section class="entete-page">
    <div class="conteneur">
      <Ariane elements={[{ nom: 'Mentions légales' }]} />
      <h1>Mentions légales</h1>
    </div>
  </section>

  <section class="section">
    <div class="conteneur prose">
      <h2>Éditeur du site</h2>
      <p>
        {editeur ?? <Manquant quoi="dénomination sociale ou nom de l’entrepreneur individuel (suivi de « EI »)" />}
        {!ei && (L.formeJuridique ? <>, {L.formeJuridique}</> : BROUILLON && <>, <Manquant quoi="forme juridique" /></>)}
        {!ei && L.capital && <> au capital de {L.capital}</>}<br />
        Nom commercial : {garage.nom}<br />
        {ligne(L.siege) && <>{ei ? 'Adresse' : 'Siège social'} : {L.siege ?? <Manquant quoi="adresse du siège social" />}<br /></>}
        Établissement : {ligneRue}, {ligneVille}<br />
        {ligne(L.siret) && <>SIRET : {L.siret ?? <Manquant quoi="SIRET" />}<br /></>}
        {ligne(L.immatriculation) && <>Immatriculation : {L.immatriculation ?? <Manquant quoi="RCS ou RNE (Kbis / extrait)" />}<br /></>}
        {L.tvaIntracom && <>TVA intracommunautaire : {L.tvaIntracom}<br /></>}
        {ligne(garage.telephone) && <>Téléphone : {garage.telephone ?? <Manquant quoi="téléphone" />}<br /></>}
        {ligne(garage.email) && <>E-mail : {garage.email ? <a href={lienEmail(garage.email)}>{garage.email}</a> : <Manquant quoi="e-mail" />}<br /></>}
      </p>
      {ligne(L.directeurPublication) && <p>Directeur de la publication : {L.directeurPublication ?? <Manquant quoi="représentant légal (Kbis)" />}</p>}

      {(H.nom || BROUILLON) && (
        <>
          <h2>Hébergement</h2>
          <p>
            {H.nom ?? <Manquant quoi="hébergeur (nom, adresse, téléphone)" />}
            {H.adresse && <><br />{H.adresse}</>}
            {H.telephone && <><br />Téléphone : {H.telephone}</>}
          </p>
        </>
      )}

      {(M || BROUILLON) && (
        <>
          <h2>Médiation de la consommation</h2>
          <p>
            Conformément aux articles L.612-1 et suivants et L.616-1 du Code de la consommation, après une réclamation écrite
            adressée à {editeur ?? garage.nom} et restée sans réponse satisfaisante, le consommateur peut saisir gratuitement le
            médiateur de la consommation suivant :{' '}
            {M?.nom ?? <Manquant quoi="nom du médiateur" />},{' '}
            {M?.adresse ?? <Manquant quoi="adresse du médiateur" />},{' '}
            {M?.site ? <a href={M.site} rel="noopener">{M.site.replace(/^https?:\/\//, '')}</a> : <Manquant quoi="site internet du médiateur" />}.
          </p>
        </>
      )}

      <h2>Contenus du site</h2>
      <p>Sauf mention contraire (voir Crédits), les contenus de ce site sont publiés par {editeur ?? garage.nom}. Leur reproduction sans autorisation est interdite.</p>

      <h2>Crédits</h2>
      <ul>
        <li>Icônes : <a href="https://lucide.dev" rel="noopener">Lucide</a> (licence ISC).</li>
        <li>Polices : Barlow Condensed et Inter (SIL Open Font License), hébergées sur ce site.</li>
        <li>Données sur les communes : INSEE et Etalab (découpage administratif), La Poste (codes postaux).</li>
      </ul>
    </div>
  </section>
</Base>
