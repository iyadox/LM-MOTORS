---
/**
 * Boutons d'action (appel, WhatsApp, devis). N'affiche que les moyens de contact réellement connus.
 */
import Icon from './Icon.astro';
import { BROUILLON, garage, lienAppel, lienWhatsAppDevis } from '../lib/site.mjs';

interface Props {
  variante?: 'hero' | 'carte' | 'barre' | 'entete' | 'cta';
  devis?: boolean;
  whatsapp?: boolean;
}
const { variante = 'hero', devis = true, whatsapp = true } = Astro.props;
const compact = variante === 'barre' || variante === 'entete';
const classeLarge = variante === 'carte' ? 'btn--large' : '';
const appelSombre = variante === 'cta';
// Sans téléphone affiché, le devis devient l'action principale.
const appelAffiche = Boolean(lienAppel) || (BROUILLON && variante !== 'barre');
const devisPrincipal = !appelAffiche;
---
{lienAppel ? (
  <a
    href={lienAppel}
    class:list={['btn', appelSombre ? 'btn--sombre' : 'btn--accent', classeLarge, variante === 'entete' && 'btn--entete-appel']}
    data-suivi="Appel"
  >
    <Icon name="phone" size={20} />
    <span class="btn__libelle">{compact ? 'Appeler' : `Appeler le ${garage.telephone}`}</span>
  </a>
) : BROUILLON && variante !== 'barre' ? (
  <span class:list={['btn', appelSombre ? 'btn--sombre' : 'btn--accent', classeLarge, variante === 'entete' && 'btn--entete-appel']} aria-disabled="true" title="Numéro de téléphone à compléter dans src/data/garage.mjs">
    <Icon name="phone" size={20} />
    <span class="btn__libelle">{compact ? 'Tél. à compléter' : 'Téléphone à compléter'}</span>
  </span>
) : null}

{whatsapp && lienWhatsAppDevis && (
  <a href={lienWhatsAppDevis} class:list={['btn', 'btn--whatsapp', classeLarge]} data-suivi="WhatsApp" target="_blank" rel="noopener">
    <Icon name="message-circle" size={20} />
    <span class="btn__libelle">WhatsApp</span>
  </a>
)}

{devis && (
  <a
    href="/devis/"
    class:list={['btn', devisPrincipal ? (appelSombre ? 'btn--sombre' : 'btn--accent') : 'btn--contour', classeLarge, variante === 'entete' && 'btn--entete-devis']}
    data-suivi="Clic devis"
  >
    <Icon name="calendar-check" size={20} />
    <span class="btn__libelle">{variante === 'barre' ? 'Devis' : compact ? 'Devis / RDV' : 'Demander un devis ou un RDV'}</span>
  </a>
)}
