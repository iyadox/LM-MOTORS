---
/**
 * Avis publiés sur Google (src/data/avis.mjs), recopiés sans modification, les plus récents
 * d'abord, quelle que soit la note. D.111-17 C. conso : informations sur le contrôle, les dates et
 * le classement à proximité (sous la liste) ; contrepartie, délai de publication et durée de
 * conservation dans la rubrique « Comment les avis sont publiés » de /avis/.
 */
import { avis as tous } from '../data/avis.mjs';

const avis = [...tous].sort((a, b) => b.date.localeCompare(a.date));

interface Props {
  max?: number;
}
const { max = avis.length } = Astro.props;
const fmtDate = new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
---
{avis.length > 0 && (
  <div class="grille grille--3">
    {avis.slice(0, max).map((a) => (
      <figure class="carte avis">
        <p class="avis__note"><span aria-hidden="true">{'★'.repeat(a.note)}{'☆'.repeat(5 - a.note)}</span><span class="visuellement-cache">Note : {a.note} sur 5</span></p>
        <blockquote><p>« {a.texte} »</p></blockquote>
        <figcaption>
          {a.auteur} · publié le {fmtDate.format(new Date(a.date))}
          {a.dateExperience ? ` · expérience de ${a.dateExperience}` : ' · date de l’expérience non indiquée'} ·{' '}
          {a.lien ? <a href={a.lien} target="_blank" rel="noopener">{a.source}</a> : a.source}
        </figcaption>
      </figure>
    ))}
  </div>
)}
{avis.length > 0 && (
  <p class="note-bas">
    Avis recopiés sans modification depuis la fiche Google du garage, du plus récent au plus ancien, quelle que soit la note.
    Ces avis ne sont pas vérifiés par le garage ; ils sont soumis à la modération de Google.
    {' '}<a href="/avis/#publication-avis">Comment les avis sont publiés</a>.
  </p>
)}
