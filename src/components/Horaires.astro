---
/**
 * Tableau des horaires + statut « Ouvert / Fermé » calculé en direct (heure de Paris,
 * jours fériés et fermetures datées compris). Si les horaires sont inconnus :
 * « À compléter » en brouillon, invitation à appeler en production.
 */
import Manquant from './Manquant.astro';
import { garage, JOURS, formaterPlages, lienAppel } from '../lib/site.mjs';

interface Props {
  statutSeul?: boolean;
  clair?: boolean;
}
const { statutSeul = false, clair = true } = Astro.props;
const h = garage.horaires;
const donnees = h
  ? JSON.stringify({ horaires: h, options: { ouvertJoursFeries: garage.ouvertJoursFeries, fermeturesDates: garage.fermeturesDates } })
  : '';
const fmtDate = new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const aujourdhui = new Date().toISOString().slice(0, 10);
const fermeturesAVenir = (garage.fermeturesDates || []).filter((f) => f.au >= aujourdhui);
---
{h ? (
  statutSeul ? (
    <span class:list={['statut', clair && 'statut--clair']} data-statut-horaires={donnees} hidden></span>
  ) : (
    <div class="bloc-horaires">
      <p><span class:list={['statut', clair && 'statut--clair']} data-statut-horaires={donnees} hidden></span></p>
      <table class="horaires" data-tableau-horaires>
        <caption class="visuellement-cache">Horaires d’ouverture</caption>
        <tbody>
          {h.map((j, i) => (
            <tr data-jour={i}>
              <th scope="row">{JOURS[i]}</th>
              <td>{formaterPlages(j.plages)}</td>
            </tr>
          ))}
        </tbody>
      </table>
      {garage.ouvertJoursFeries === false && <p class="champ__aide">Fermé les jours fériés.</p>}
      {fermeturesAVenir.map((f) => (
        <p class="champ__aide">{f.texte || 'Fermeture'} : du {fmtDate.format(new Date(`${f.du}T12:00:00Z`))} au {fmtDate.format(new Date(`${f.au}T12:00:00Z`))}.</p>
      ))}
    </div>
  )
) : statutSeul ? null : (
  <p>
    <Manquant quoi="horaires d’ouverture">
      {lienAppel ? <span>Horaires communiqués par téléphone : <a href={lienAppel} data-suivi="Appel" data-suivi-lieu="horaires">{garage.telephone}</a>.</span> : <span>Horaires communiqués sur demande.</span>}
    </Manquant>
  </p>
)}

<script>
  import { initialiserHoraires } from '../scripts/horaires.js';
  initialiserHoraires();
</script>
